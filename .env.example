# Database
# You can use any PostgreSQL database. Examples:
# Local: postgresql://user:password@localhost:5432/cssa
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[database]
# Or use Prisma Postgres: npx prisma dev
DATABASE_URL="postgresql://user:password@localhost:5432/cssa"

# NextAuth
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-replace-with-random-string"
NEXTAUTH_URL="http://localhost:3000"
